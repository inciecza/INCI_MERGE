                      <CellContents>
                        <Textbox Name="tbM16">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(IIF(Fields!MonthIdx.Value=1,CDec(Fields!Devir.Value),CDec(0)),"DataSet_Result")+Sum(IIF(Fields!MonthIdx.Value=1,CDec(Fields!UsdEur.Value),CDec(0)),"DataSet_Result")+Sum(IIF(Fields!MonthIdx.Value=1,CDec(Fields!GrupIciGelir.Value),CDec(0)),"DataSet_Result")+Sum(IIF(Fields!MonthIdx.Value=1,CDec(Fields!MusCekMevcut.Value),CDec(0)),"DataSet_Result")+Sum(IIF(Fields!MonthIdx.Value=1,CDec(Fields!MusCekIlave.Value),CDec(0)),"DataSet_Result")+Sum(IIF(Fields!MonthIdx.Value=1,CDec(Fields!Ihracat.Value),CDec(0)),"DataSet_Result")+Sum(IIF(Fields!MonthIdx.Value=1,CDec(Fields!MusTahsilat.Value),CDec(0)),"DataSet_Result")</Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>Black</Color>
                                    <Format>#,##0;-#,##0;-</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
