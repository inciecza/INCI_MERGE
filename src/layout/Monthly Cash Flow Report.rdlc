            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="PLANLANAN AYLIK NAKİT AKIŞ RAPORU  (" &amp; Format(First(Fields!PostingDate.Value,"DataSet_Result"),"dd.MM.yyyy") &amp; " - " &amp; Format(DateAdd("d",-1,DateAdd("m",12,First(Fields!PostingDate.Value,"DataSet_Result"))),"dd.MM.yyyy") &amp; ")"</Value>
                    <Style>
                      <FontSize>11pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
