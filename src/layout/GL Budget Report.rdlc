                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=(Sum(IIf(Fields!Rapor_Kodu.Value = "14" ,Fields!Önceki_Yıl_Tutar.Value, CDec(0)))) /(Sum(IIf(Fields!Rapor_Kodu.Value = "10" Or Fields!Rapor_Kodu.Value = "12",Fields!Önceki_Yıl_Tutar.Value, CDec(0))))</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>0.00 %</Format>
                                    <Color>Red</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
