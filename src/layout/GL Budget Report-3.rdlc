                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(IIf(Fields!Rapor_Kodu.Value = "14" Or Fields!Rapor_Kodu.Value = "15" Or Fields!Rapor_Kodu.Value = "16" Or Fields!Rapor_Kodu.Value = "17" Or Fields!Rapor_Kodu.Value = "18", Fields!Önceki_Yıl_Tutar.Value, CDec(0)))+Fields!Faaliyet_Gideri.Value</Value>
